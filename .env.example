PROAGENT_APP_ENVIRONMENT=development
PROAGENT_DEBUG=false
PROAGENT_API_HOST=127.0.0.1
PROAGENT_API_PORT=8001
PROAGENT_API_RELOAD=true

PROAGENT_DATABASE_URL=postgresql+psycopg://proagent:proagent@localhost:5432/proagent

PROAGENT_CHECKPOINT_POOL_MIN_SIZE=1
PROAGENT_CHECKPOINT_POOL_MAX_SIZE=10

# Enable only after configuring a real AI provider and API key.
PROAGENT_AI_ENABLED=false

PROAGENT_STORAGE_ROOT=runtime/storage

PROAGENT_MAX_UPLOAD_FILES=100
PROAGENT_MAX_UPLOAD_FILE_BYTES=52428800
PROAGENT_MAX_UPLOAD_TOTAL_BYTES=524288000
PROAGENT_UPLOAD_CHUNK_BYTES=1048576

PROAGENT_MAX_PDF_PAGES=500
PROAGENT_MAX_DOCUMENT_CHARACTERS=50000
PROAGENT_MIN_NATIVE_PAGE_CHARACTERS=40

PROAGENT_MAX_ARCHIVE_FILES=80
PROAGENT_MAX_ARCHIVE_TOTAL_BYTES=262144000
PROAGENT_MAX_ARCHIVE_ENTRY_BYTES=83886080
PROAGENT_MAX_ARCHIVE_COMPRESSION_RATIO=200

PROAGENT_MAX_SPREADSHEET_CELLS=500000

PROAGENT_OFFICE_CONVERTER_BIN=libreoffice
PROAGENT_OFFICE_CONVERTER_TIMEOUT_SECONDS=120
PROAGENT_OCR_ENABLED=true
PROAGENT_OCR_PROVIDER=openparser

# Example Windows path:
# PROAGENT_TESSERACT_COMMAND=C:\Program Files\Tesseract-OCR\tesseract.exe

PROAGENT_OCR_LANGUAGE=eng
PROAGENT_OCR_RENDER_SCALE=2.0
PROAGENT_OCR_TIMEOUT_SECONDS=120

PROAGENT_OCR_MIN_PAGE_CHARACTERS=40
PROAGENT_OCR_MIN_WORDS=8
PROAGENT_OCR_MIN_ALPHANUMERIC_CHARACTERS=25
PROAGENT_OCR_MAX_NOISE_RATIO=0.15
PROAGENT_OCR_MIN_ACCEPTED_SCORE=0.40
PROAGENT_OCR_MAX_ATTEMPTS=2

PROAGENT_NATIVE_TEXT_LONG_TOKEN_CHARACTERS=80
PROAGENT_NATIVE_TEXT_LONG_TOKEN_RATIO=0.25
PROAGENT_REPEATED_BOILERPLATE_MIN_PAGES=3
PROAGENT_REPEATED_BOILERPLATE_MIN_LINE_CHARACTERS=30

PROAGENT_CLASSIFICATION_PROBE_CHARACTERS=4000
PROAGENT_CLASSIFICATION_MINIMUM_CONFIDENCE=0.60
PROAGENT_RETRIEVAL_CHUNK_CHARACTERS=1200
PROAGENT_RETRIEVAL_CHUNK_OVERLAP_CHARACTERS=200
PROAGENT_RETRIEVAL_SEARCH_CANDIDATE_POOL=24
PROAGENT_TENDER_FIELDS_CONFIG_PATH=config/tender_fields.yaml
PROAGENT_FIELD_UNDERSTANDING_PROMPT_PATH=app/tender_agent/prompts/field_understanding.yaml
PROAGENT_FIELD_RETRIEVAL_LIMIT=8
PROAGENT_FIELD_MINIMUM_CONFIDENCE=0.65
PROAGENT_FIELD_MAX_CHUNK_CHARACTERS=3500

# Gemini: main LLM, verifier, embeddings, and chat reranker.
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

AI_MODEL_FAST=gemini-3.8-flash
AI_MODEL_DEEP=gemini-3.8-flash
AI_PRIMARY_REQUEST_TIMEOUT_SECONDS=240

AI_MODEL_VERIFIER=gemini-3.8-flash
AI_VERIFIER_REQUEST_TIMEOUT_SECONDS=240

AI_MODEL_EMBEDDING=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=3072
AI_EMBEDDING_BATCH_SIZE=64
AI_EMBEDDING_REQUEST_TIMEOUT_SECONDS=120

AI_MODEL_RERANKER=gemini-3.8-flash
AI_RERANKER_API_STYLE=chat
AI_RERANKER_CANDIDATE_CHARACTERS=1800
AI_RERANKER_REQUEST_TIMEOUT_SECONDS=240
AI_MAX_RETRIES=2

# OpenParser: PaddleOCR-VL OCR service.
OPENPARSER_API_KEY=
OPENPARSER_BASE_URL=https://api.openparser.dev
OPENPARSER_OCR_MODEL=paddleocr-vl-1.6
OPENPARSER_REQUEST_TIMEOUT_SECONDS=240
OPENPARSER_MAX_RESPONSE_MB=50


PROAGENT_NORMALIZATION_DEFAULT_CURRENCY=INR
PROAGENT_NORMALIZATION_DEFAULT_TIMEZONE=Asia/Kolkata
PROAGENT_RECONCILIATION_MINIMUM_CONFIDENCE=0.65
PROAGENT_REQUIREMENT_DICTIONARY_PATH=config/requirement_dictionary.yaml
PROAGENT_REQUIREMENT_PROMPT_PATH=app/tender_agent/prompts/requirement_extraction.yaml
PROAGENT_REQUIREMENT_RETRIEVAL_LIMIT=12
PROAGENT_REQUIREMENT_MINIMUM_CONFIDENCE=0.65
PROAGENT_REQUIREMENT_MAX_CHUNK_CHARACTERS=3500
PROAGENT_COVERAGE_POLICY_PATH=app/tender_agent/prompts/coverage_audit.yaml
